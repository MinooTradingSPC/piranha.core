@using Piranha.Manager
@inject ManagerLocalizer Localizer
@inject IAuthorizationService Auth
@inject ManagerLocalizationOptions LocalizationOptions
@inject Piranha.Config Config
@{
    var menu = await Menu.Items.GetForUser(User, Auth);
    var logout = Piranha.App.Modules.Manager().LogoutUrl;
    var languages = LocalizationOptions.SupportedCultures;
    var current = ViewBag.MenuItem as string;
    var groupIndex = 0;
}

<nav class="navbar navbar-left fixed-top navbar-dark bg-dark" style="--manager-menu-width: @(Config.ManagerMenuWidth)px">
    <a class="navbar-brand" href="~/manager" tabindex="-1"></a>
    <ul class="navbar-nav">
        @foreach (var group in menu)
        {
            var groupId = $"manager-menu-group-{ groupIndex++ }";
            var contentGroups = group.InternalId == "Content"
                ? Piranha.App.ContentGroups.Where(g => !g.IsHidden).ToList()
                : new List<Piranha.Models.ContentGroup>();
            var isCurrent = group.Items.Any(i => i.InternalId == current) ||
                contentGroups.Any(i => i.Id == current);

            <li class="nav-item nav-group@(isCurrent ? " current" : "")" data-manager-menu-group="@(group.InternalId ?? group.Name)">
                <button type="button" class="nav-header navbar-text" aria-expanded="true" aria-controls="@groupId">
                    <i class="@group.Css"></i><span class="nav-header-title">@Localizer.Menu[group.Name]</span><i class="fas fa-chevron-down nav-group-toggle" aria-hidden="true"></i>
                </button>
                <ul class="nav-group-items" id="@groupId">
                    @foreach (var item in group.Items)
                    {
                        <li class="nav-item@(item.InternalId == current ? " active" :"")"><a href="@Url.Content(item.Route)" class="nav-link" tabindex="-1"><i class="@item.Css"></i>@Localizer.Menu[item.Name]</a></li>
                    }
                    @foreach (var item in contentGroups)
                    {
                        <li class="nav-item@(item.Id == current ? " active" :"")"><a href="@Url.Content($"~/manager/content/{ item.Id }")" class="nav-link" tabindex="-1"><i class="@item.Icon"></i>@item.Title</a></li>
                    }
                </ul>
            </li>
        }
        <li class="nav-item nav-header"><a class="navbar-text" href="@Url.Content(logout)"><i class="fas fa-power-off"></i>@Localizer.Menu["Logout"]</a></li>
    </ul>
    <div class="manager-preferences">
        @if (languages.Count > 0)
        {
            <div class="manager-icon-chooser manager-language-chooser" role="group" aria-label="@Localizer.General["Language"]">
                @foreach (var language in languages)
                {
                    <button type="button"
                            data-manager-language-value="@language.Name"
                            title="@language.NativeName"
                            aria-label="@language.NativeName">
                        <img class="language-flag" data-manager-language-flag="@language.Name" alt="" aria-hidden="true">
                    </button>
                }
            </div>
        }
        <div class="manager-icon-chooser manager-theme-chooser" role="group" aria-label="@Localizer.General["Color theme"]">
            <button type="button" data-manager-theme-value="light" title="@Localizer.General["Light theme"]" aria-label="@Localizer.General["Light theme"]">
                <i class="fas fa-sun"></i>
            </button>
            <button type="button" data-manager-theme-value="dark" title="@Localizer.General["Dark theme"]" aria-label="@Localizer.General["Dark theme"]">
                <i class="fas fa-moon"></i>
            </button>
        </div>
    </div>
</nav>
