@inject ManagerLocalizer Localizer
@{
    ViewBag.Title = "Account security";
    ViewBag.MenuItem = "AccountSecurity";
}
@section script {
    <script src="~/manager/identity/piranha.accountsecurity.js"></script>
    <script type="text/javascript">
        piranha.accountsecurity.promptSetup = @(Context.Request.Query["setup"] == "1" ? "true" : "false");
        piranha.accountsecurity.load();
    </script>
}
<div id="accountsecurity">
    <div class="top">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Localizer.General["Settings"]</li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer.General["Account security"]</li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid app" :class="{ ready: !loading }">
        <div v-if="promptSetup" class="alert alert-info">
            @Localizer.General["You signed in with an emailed code. Set up a passkey or an authenticator app below so you always have a way in without relying on email."]
        </div>
        <div v-else-if="strongMethodCount === 0" class="alert alert-warning">
            @Localizer.General["You're only signing in with a password. Add a passkey or an authenticator app for stronger protection."]
        </div>

        <div class="card">
            <div class="card-header">
                <span class="title">@Localizer.General["Passkeys"]</span>
            </div>
            <div class="card-body">
                <p class="text-muted">@Localizer.General["Sign in with Windows Hello, Touch ID, a security key, or your device's screen lock instead of a password."]</p>
                <ul class="list-group mb-3" v-if="passkeys.length > 0">
                    <li class="list-group-item d-flex justify-content-between align-items-center" v-for="passkey in passkeys" :key="passkey.id">
                        <div>
                            <a href="#" v-on:click.prevent="renamePasskey(passkey)"><strong>{{ passkey.deviceName }}</strong> <i class="fas fa-pen small text-muted"></i></a>
                            <div class="text-muted small">@Localizer.General["Added"] {{ passkey.created }}<span v-if="passkey.lastUsed"> &middot; @Localizer.General["Last used"] {{ passkey.lastUsed }}</span></div>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger btn-icon" v-on:click.prevent="removePasskey(passkey)" title="@Localizer.General["Delete"]">
                            <i class="fas fa-trash"></i>
                        </button>
                    </li>
                </ul>
                <p v-else class="text-muted">@Localizer.General["No passkeys registered yet."]</p>
                <button type="button" class="btn btn-primary" :disabled="registeringPasskey" v-on:click.prevent="registerPasskey()">
                    <i class="fas fa-plus"></i> @Localizer.General["Add a passkey"]
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="title">@Localizer.General["Authenticator app"]</span>
            </div>
            <div class="card-body">
                <p class="text-muted">@Localizer.General["Sign in with a 6-digit code from an app like Google Authenticator, Microsoft Authenticator, Authy, or Aegis, as a fallback next to passkeys."]</p>

                <div v-if="totpEnrollment">
                    <p>@Localizer.General["Scan this code with your authenticator app:"]</p>
                    <img :src="'data:image/png;base64,' + totpEnrollment.qrCodePngBase64" alt="QR code" style="max-width:200px" />
                    <p class="text-muted small">@Localizer.General["Or enter this key manually:"] <code>{{ totpEnrollment.secret }}</code></p>
                    <div class="form-group">
                        <label>@Localizer.General["Enter the 6-digit code from the app to confirm"]</label>
                        <input type="text" inputmode="numeric" maxlength="6" class="form-control small" v-model="totpConfirmCode" />
                    </div>
                    <button type="button" class="btn btn-primary" :disabled="totpBusy || totpConfirmCode.length !== 6" v-on:click.prevent="confirmTotpEnrollment()">
                        @Localizer.General["Confirm"]
                    </button>
                    <button type="button" class="btn btn-secondary" v-on:click.prevent="cancelTotpEnrollment()">
                        @Localizer.General["Cancel"]
                    </button>
                </div>
                <div v-else-if="totpStatus.enrolled">
                    <p class="text-muted">@Localizer.General["Confirmed"] {{ totpStatus.confirmedAt }}</p>
                    <button type="button" class="btn btn-secondary" :disabled="totpBusy" v-on:click.prevent="beginTotpEnrollment()">
                        @Localizer.General["Set up a new authenticator"]
                    </button>
                    <button type="button" class="btn btn-danger" v-on:click.prevent="revokeTotp()">
                        @Localizer.General["Remove"]
                    </button>
                </div>
                <button v-else type="button" class="btn btn-primary" :disabled="totpBusy" v-on:click.prevent="beginTotpEnrollment()">
                    <i class="fas fa-plus"></i> @Localizer.General["Set up an authenticator app"]
                </button>
            </div>
        </div>
    </div>
</div>
